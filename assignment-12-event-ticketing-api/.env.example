# ------------------------------------------------------------------
# Event Management & Ticketing API — environment configuration
# Copy this file to `.env` and fill in real values.  NEVER commit .env
# ------------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# Secret used to sign & verify JWT access tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: how long issued JWTs stay valid (e.g. 1h, 2d). Defaults to 1d.
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------
# Firebase Admin credentials
# ------------------------------------------------------------------
# Absolute path to a Google service-account JSON key file.
# If unset, the app falls back to ./serviceAccountKey.json (gitignored).
# Leave blank to run the server WITHOUT Firestore (DB routes degrade
# gracefully with a clear error instead of crashing).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
